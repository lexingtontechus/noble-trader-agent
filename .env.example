# ============================================================
# HERMES TRADING PLATFORM - ENVIRONMENT CONFIGURATION
# ============================================================
#
# ⚠️  SECURITY WARNING: This file contains SENSITIVE information.
# - NEVER commit this file to version control
# - NEVER share this file with anyone
# - Use strong, unique values for all secrets
# - Generate secrets with: python -c "import secrets; print(secrets.token_urlsafe(N))"
#
# Copy this file to .env and fill in your actual values:
#   cp .env.example .env
#

# === Secrets backend selection ===
# Which resolver to use for `secret:` prefixed config values
SECRETS_BACKEND=env_file                  # env_file | env | vault | aws_sm
SECRETS_ENV_FILE_PATH=./.env

# === Noble Trader upstream (Redis — signal stream) ===
# The agent reads ONLY the proxy re-published stream `signal.proxy.noble_trader`.
# NOBLE_TRADER_PROXY_REDIS_URL points at the proxy's Railway Redis. Credentials
# (the `sub_<hex>` user from your NT subscription) are embedded in the URL.
# The agent does NOT read `signal.raw.noble_trader` (backend->proxy transport) directly.
NOBLE_TRADER_PROXY_REDIS_URL=redis://sub_xxxx:password@sakura.proxy.rlwy.net:36624
# Public SSE endpoint for quote data. No separate credential — auth is via
# the X-Plan-Prefix header (derived from the Redis username in the URL above).
NOBLE_TRADER_QUOTE_PROXY_URL=https://noble-trader-proxy-production.up.railway.app

# === Agent liveness monitors (see AGENTS.md §2) ===
# WARNING if agent receives NO qualified signal for this many seconds (default 4h).
NOBLE_TRADER_SIGNAL_DROUGHT_ALERT_SEC=14400
# CRITICAL if no proxy delivery heartbeat (proxy_delivery_log) in this many sec (480).
NOBLE_TRADER_PROXY_HEARTBEAT_TIMEOUT_SEC=480
# CRITICAL if no frame from proxy /sse/alerts in this many seconds (default 90).
NOBLE_TRADER_SSE_LIVENESS_TIMEOUT_SEC=90

# === Noble Trader upstream (Supabase — historical sweeps + regime logs) ===
# Placeholder URL — replace with actual Supabase project URL in .env
SUPABASE_URL=https://<your-project>.supabase.co
# Use the ANON/PUBLISHABLE key (safe for open-source / multi-agent deployments).
# The anon key is subject to Row-Level Security (RLS) policies, which the NT
# operator must configure to allow SELECT on nt_sweep_result + nt_regime_log.
# This is intentionally NOT the service_role key — that would grant full admin
# access to the entire Supabase project, which is unsafe to distribute.
SUPABASE_ANON_KEY=<publishable-anon-key>
SUPABASE_SWEEP_RESULT_TABLE=nt_sweep_result                  # confirmed from NT schema
SUPABASE_REGIME_LOG_TABLE=nt_regime_log                      # confirmed from NT schema

# === Hermes infrastructure ===
HERMES_DUCKDB_PATH=./data/hermes.duckdb
HERMES_REDIS_URL=redis://localhost:6379/1                     # separate DB number from NT
HERMES_LOG_LEVEL=INFO
HERMES_ENVIRONMENT=development                               # development | staging | production

# === Dashboard / API auth (single-user + agent) ===
# ⚠️  IMPORTANT: These MUST be strong, unique values in production!
# Browser login (session cookie) — set HERMES_ADMIN_PASSWORD to a strong password.
# Generate strong secrets:
#   python -c "import secrets; print('HERMES_SESSION_SECRET=' + secrets.token_urlsafe(48))"
#   python -c "import secrets; print('HERMES_ADMIN_PASSWORD=' + secrets.token_urlsafe(32))"
#   python -c "import secrets; print('HERMES_AGENT_TOKEN=' + secrets.token_urlsafe(64))"
#
# See docs/roadmap.md §14 for the full auth model.
# NOTE: The values above are REQUIRED - there are no default fallbacks!

# ── TradingView (RapidAPI — Price Data) ────────────────────────────────────
# TradingView API via RapidAPI provides OHLCV candle data for crypto,
# forex, stocks, commodities, and more.
# Sign up at https://rapidapi.com/ and subscribe to the TradingView API.
# Plan: Ultra (100k requests/month)
TRADINGVIEW_API_KEY=
TRADINGVIEW_API_HOST=tradingview-data1.p.rapidapi.com
TRADINGVIEW_BASE_URL=https://tradingview-data1.p.rapidapi.com

# ============================================================
# USER CONFIGURATION OVERRIDES
# ============================================================
# For non-secret configuration overrides (account parameters,
# trade parameters, venue enablement, initial symbols), create:
#   config/user.local.yaml
# This file is git-ignored and allows tenant-specific config
# without touching code or .env files.
#
# See config/user.example.yaml for the template.
# ============================================================
METAAPI_TOKEN=
METAAPI_ACCOUNT_ID=
NT_MODE=

# === Redis Credential Encryption (for Supabase integration) ===
# Used to decrypt Redis passwords from the redis_credentials table (migration 0004).
# Generate with: python -c "import secrets; print('REDIS_CRED_ENCRYPTION_KEY=' + secrets.token_urlsafe(32))"
# This key MUST match the one used by the Supabase edge function.
REDIS_CRED_ENCRYPTION_KEY=
